# Google Cloud Platform & BigQuery Configuration
GCP_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=US
BQ_RAW_DATASET=weather_raw
BQ_ANALYTICS_DATASET=weather_analytics

# Optional: Path to Service Account JSON key (if not using gcloud CLI / ADC)
# GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json

# AtmoSync Micro-Climate & Arbitrage Settings
AISSTREAM_API_KEY=your_free_aisstream_key
AIS_MODE=sim
SIM_BACKFILL_HOURS=24
SIM_HOURS_AT_SEA=30
AVOCADO_CSV=avocado-updated-2020.csv
